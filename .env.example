# Database
POSTGRES_USER=nurse
POSTGRES_PASSWORD=nurse_secret
POSTGRES_DB=nurse_assistant
DATABASE_URL=postgresql+asyncpg://nurse:nurse_secret@localhost:5432/nurse_assistant

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nurse-reports
MINIO_SECURE=false

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM (DeepSeek / OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_EMBEDDING_MODEL=text-embedding-3-small
# 是否启用 RAG 知识检索（调试记忆功能时可暂时设为 false）
ENABLE_RAG=true

# iFlytek Voice (语音听写 ASR + 语音合成 TTS，注册讯飞开放平台获取)
IFLYTEK_APPID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
IFLYTEK_TTS_VOICE=xiaoyan

# App
APP_NAME=贴心小护士
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
